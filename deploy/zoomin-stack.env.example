# Environment variables stack Portainer untuk compose.yml (root repo). Stacks > Environment variables, atau
# "Load variables from .env file". HANYA placeholder: jangan commit nilai asli.
#
# Generate:
#   openssl rand -base64 48            -> BETTER_AUTH_SECRET (minimal 32 karakter)
# LIVEKIT_API_KEY/SECRET = pasangan yang sama dengan env stack LiveKit (deploy/livekit-stack.env.example).

# Wajib
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dianjurkan: email super_admin, dipisah koma.
SUPER_ADMIN_EMAILS=

# Opsional (default di compose.yml)
# Tag image: latest | sha-<7 char> | versi rilis (mis. 0.1.0). Ganti untuk rollback.
ZOOMIN_TAG=
# Host router Traefik (default zoomin.wibudev.com). Harus mengarah ke VPS (DNS/Cloudflare).
ZOOMIN_HOST=
# Default https://zoomin.wibudev.com; ubah bila ZOOMIN_HOST diubah.
PUBLIC_APP_URL=
BETTER_AUTH_URL=
# Default ws://livekit:7880 (container LiveKit di network public-net). Alternatif: wss://lk.wibudev.com
LIVEKIT_URL=
# Default wss://lk.wibudev.com
PUBLIC_LIVEKIT_URL=
