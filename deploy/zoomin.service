# /etc/systemd/system/zoomin.service — app Bun (SPA + API) di belakang Caddy.
[Unit]
Description=Zoomin app (Bun + Elysia)
After=network-online.target livekit.service
Wants=network-online.target

[Service]
Type=simple
User=zoomin
Group=zoomin
# Symlink ke rilis aktif; rollback = arahkan ulang symlink lalu restart (README §Rollback).
WorkingDirectory=/opt/zoomin/current
Environment=NODE_ENV=production
# HOST + TRUST_PROXY berpasangan: TRUST_PROXY=true mempercayai X-Forwarded-For (bisa dipalsukan klien), jadi port app
# tidak boleh terjangkau langsung; listen hanya di loopback, satu-satunya jalan masuk lewat Caddy.
# Diset di unit (bukan hanya env file) agar invarian keamanan ikut ter-review di repo. EnvironmentFile MENIMPA
# Environment=, jadi hapus baris NODE_ENV/HOST/TRUST_PROXY/DB_PATH dari /etc/zoomin/zoomin.env (README).
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=true
# DB di luar folder rilis agar tidak ikut terganti saat deploy. StateDirectory membuat /var/lib/zoomin (0750).
Environment=DB_PATH=/var/lib/zoomin/zoomin.sqlite
# Matikan cache transpiler (default menulis ke cache dir platform, read-only di bawah ProtectSystem=strict).
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# Secret (LIVEKIT_API_KEY/SECRET, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID/SECRET) + SUPER_ADMIN_EMAILS, PORT, URL.
# Mode 640 root:zoomin. Jangan isi ZOOMIN_TEST_AUTH (khusus test otomatis; production mengabaikannya).
EnvironmentFile=/etc/zoomin/zoomin.env
# Butuh dist/web (bun run build, ikut di tarball rilis); tanpanya start gagal dan systemd mengulang (Restart=on-failure).
ExecStart=/usr/local/bin/bun src/server/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=zoomin
StateDirectoryMode=0750

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
