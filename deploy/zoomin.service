# /etc/systemd/system/zoomin.service — app Bun (SPA + API) di belakang Caddy.
[Unit]
Description=Zoomin app (Bun + Elysia)
After=network-online.target livekit.service
Wants=network-online.target

[Service]
Type=simple
User=zoomin
Group=zoomin
# Symlink ke rilis aktif; rollback = arahkan ulang symlink lalu restart (README §Rollback).
WorkingDirectory=/opt/zoomin/current
Environment=NODE_ENV=production
# DB di luar folder rilis agar tidak ikut terganti saat deploy. StateDirectory membuat /var/lib/zoomin (0750).
Environment=DB_PATH=/var/lib/zoomin/zoomin.sqlite
# Matikan cache transpiler (default menulis ke cache dir platform, read-only di bawah ProtectSystem=strict).
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# Secret (LIVEKIT_API_KEY/SECRET, SESSION_SECRET, ADMIN_PASSWORD) + PORT, URL, TRUST_PROXY=true. Mode 640 root:zoomin.
EnvironmentFile=/etc/zoomin/zoomin.env
ExecStart=/usr/local/bin/bun src/server/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=zoomin
StateDirectoryMode=0750

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
