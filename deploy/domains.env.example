# Nama domain produksi (bukan secret). Salin ke /etc/zoomin/domains.env. Dibaca Caddy (EnvironmentFile drop-in)
# dan envsubst saat render livekit.yaml. Subdomain final = keputusan K3.
APP_DOMAIN=app.example.com
LK_DOMAIN=lk.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=ops@example.com
# true bila server punya IP publik (K1=b); false bila klien hanya lewat tailnet (K1=a).
LK_USE_EXTERNAL_IP=true
