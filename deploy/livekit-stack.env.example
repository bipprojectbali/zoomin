# Environment variables stack Portainer untuk deploy/livekit-compose.yml (Stacks > Environment variables,
# atau "Load variables from .env file"). Jangan commit nilai asli. Nilai yang sama diisi di .env zoomin.
#
# Generate:
#   echo "API$(openssl rand -hex 6)"   -> LIVEKIT_API_KEY
#   openssl rand -base64 33            -> LIVEKIT_API_SECRET
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opsional: IP tempat API/signaling :7880 listen (default 0.0.0.0). Mis. IP Tailscale VPS (100.x) agar 7880
# hanya terjangkau dari tailnet. Tidak memengaruhi port media (7881/TCP, 50000-60000/UDP, 3478/UDP).
LIVEKIT_BIND=
