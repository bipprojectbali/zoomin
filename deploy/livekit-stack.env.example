# Environment variables stack Portainer untuk deploy/livekit-compose.yml (Stacks > Environment variables,
# atau "Load variables from .env file"). Jangan commit nilai asli. Key/secret yang sama diisi di .env zoomin.
#
# Generate:
#   echo "API$(openssl rand -hex 6)"   -> LIVEKIT_API_KEY
#   openssl rand -base64 33            -> LIVEKIT_API_SECRET
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opsional: domain signaling untuk router Traefik (default lk.wibudev.com). Harus mengarah ke VPS (DNS/Cloudflare).
LIVEKIT_HOST=
