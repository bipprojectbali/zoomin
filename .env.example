# Template konfigurasi zoomin. Buat file: `zoomin env > .env` (atau `cp .env.example .env`).
# Nilai aktif di bawah = default dev lokal: langsung jalan dengan `livekit-server --dev` + `bun run dev`.
# Baris `# contoh produksi: ...` adalah contoh deploy (domain example.com); salin, hapus `# contoh produksi:`, sesuaikan.
# Format: NAMA=nilai, tanpa spasi di sekitar `=`, tanpa tanda kutip. Kosong = pakai default.

# ── 1. Mode & jaringan app ──

# Mode app: `development` atau `production`. Production mewajibkan LIVEKIT_API_KEY, LIVEKIT_API_SECRET,
# BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (server gagal start bila kosong) dan menyajikan SPA hasil build.
# Binary `zoomin` berjalan sebagai production bila NODE_ENV tidak diset sama sekali.
# contoh produksi: NODE_ENV=production
NODE_ENV=development

# Port listen HTTP(S) app. Opsional, default 3000. Bisa ditimpa flag `-p/--port`.
PORT=3000

# Interface listen app. Opsional, default 0.0.0.0 (semua interface, bisa dibuka dari HP di LAN).
# Di belakang reverse proxy/tunnel (Caddy, Traefik, Cloudflare Tunnel di host yang sama) pakai 127.0.0.1
# agar port app tidak terbuka langsung. Catatan: buka app via http://localhost:3000, bukan http://0.0.0.0:3000
# (0.0.0.0 bukan secure context, kamera/mikrofon diblok browser).
# contoh produksi: HOST=127.0.0.1
HOST=0.0.0.0

# Path file SQLite. Opsional, default ./data/zoomin.sqlite (direktori dibuat otomatis). Bisa ditimpa flag `--db`.
# contoh produksi: DB_PATH=/var/lib/zoomin/zoomin.sqlite
DB_PATH=./data/zoomin.sqlite

# true hanya bila app HANYA bisa dicapai lewat reverse proxy/tunnel: IP klien (rate limit) diambil dari
# X-Forwarded-For. Opsional, default false (IP peer TCP). Bila true, JANGAN expose port app (pakai HOST=127.0.0.1),
# karena klien bisa memalsukan header X-Forwarded-For.
# contoh produksi: TRUST_PROXY=true
TRUST_PROXY=false

# ── 2. URL publik ──

# Base URL app sebagaimana dibuka pengguna; menentukan link undangan yang dibagikan. Opsional, default
# http://localhost:3000. Format: skema + host (+ port), tanpa garis miring di akhir.
# contoh produksi: PUBLIC_APP_URL=https://meet.example.com
PUBLIC_APP_URL=http://localhost:3000

# ── 3. LiveKit ──

# URL LiveKit yang dipakai server app (API server-ke-server + target proxy /livekit). Opsional, default
# ws://127.0.0.1:7880 (`livekit-server --dev`). Format ws:// atau wss://.
# contoh produksi (LiveKit di VPS via Traefik): LIVEKIT_URL=wss://lk.example.com
LIVEKIT_URL=ws://127.0.0.1:7880

# URL LiveKit yang dikirim ke browser. Opsional, default = LIVEKIT_URL. Di produksi harus wss:// yang bisa
# dibuka dari internet. Dua pilihan: (a) sama dengan LIVEKIT_URL bila LiveKit punya domain sendiri, atau
# (b) satu hostname saja (mis. Cloudflare Tunnel ke app): PUBLIC_APP_URL versi wss:// + /livekit, app mem-proxy ke LIVEKIT_URL.
# contoh produksi (a): PUBLIC_LIVEKIT_URL=wss://lk.example.com
# contoh produksi (b): PUBLIC_LIVEKIT_URL=wss://meet.example.com/livekit
PUBLIC_LIVEKIT_URL=

# API key + secret LiveKit. Wajib di produksi; kosong di dev = devkey/secret (cocok dengan `livekit-server --dev`).
# HARUS sama persis dengan pasangan di server LiveKit (env stack Portainer / bagian `keys:` livekit.yaml).
# Buat pasangan baru: `lk generate-keys`, atau key: echo "API$(openssl rand -hex 6)" dan secret: openssl rand -base64 33
# contoh produksi: LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_KEY=
# Secret pasangan LIVEKIT_API_KEY (lihat di atas). Wajib di produksi; kosong di dev = secret. Jangan dibagikan.
LIVEKIT_API_SECRET=

# ── 4. Login Google & sesi (Better Auth) ──
# Satu-satunya cara login adalah akun Google (tidak ada login password). Dev lokal tanpa GOOGLE_CLIENT_ID/SECRET tetap
# jalan, tapi tombol "Masuk dengan Google" menampilkan "Login Google belum dikonfigurasi".
# Login Google lokal: PUBLIC_APP_URL dan BETTER_AUTH_URL = http://localhost:3000 (atau kosongkan BETTER_AUTH_URL) dan
# buka app lewat http://localhost:3000, bukan IP LAN/0.0.0.0 (origin harus sama dengan yang didaftarkan di Google).
#
# Membuat OAuth client Google (console.cloud.google.com):
#   1. APIs & Services → OAuth consent screen: isi nama app + email; scope cukup default (email, profile, openid).
#   2. Credentials → Create credentials → OAuth client ID → Application type "Web application".
#   3. Authorized JavaScript origins: PUBLIC_APP_URL (mis. https://meet.example.com; lokal http://localhost:3000).
#   4. Authorized redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google
#      (mis. https://meet.example.com/api/auth/callback/google; lokal http://localhost:3000/api/auth/callback/google).
#   5. Salin Client ID + Client secret ke GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
#   6. Consent screen status "Testing" hanya mengizinkan akun yang didaftarkan sebagai test user (maks 100 akun);
#      untuk umum tekan "Publish app" (status "In production").

# Kunci rahasia Better Auth: cookie sesi, state OAuth, dan tanda tangan link undangan. Wajib di produksi, minimal
# 32 karakter; kosong di dev = kunci dev bawaan. Buat: openssl rand -base64 48
# Mengganti nilai ini = semua user ter-logout dan semua link undangan lama tidak berlaku. Jangan dibagikan.
# contoh produksi: BETTER_AUTH_SECRET=<hasil openssl rand -base64 48>
BETTER_AUTH_SECRET=

# Base URL Better Auth (callback OAuth). Opsional, default = PUBLIC_APP_URL (bila hanya BETTER_AUTH_URL yang diisi,
# PUBLIC_APP_URL ikut nilai ini). Harus sama dengan origin yang dibuka browser, dan
# <BETTER_AUTH_URL>/api/auth/callback/google harus terdaftar sebagai redirect URI di Google; beda = redirect_uri_mismatch.
# contoh produksi: BETTER_AUTH_URL=https://meet.example.com
BETTER_AUTH_URL=

# Client ID OAuth Google (langkah di atas). Wajib di produksi; kosong di dev = login Google belum dikonfigurasi.
# contoh produksi: GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Client secret pasangan GOOGLE_CLIENT_ID. Wajib di produksi; kosong di dev = login Google belum dikonfigurasi. Jangan dibagikan.
GOOGLE_CLIENT_SECRET=

# Email super_admin dipisah koma (spasi di-trim, huruf besar/kecil diabaikan). Satu-satunya cara menjadi
# super_admin: disinkronkan setiap login (email ada di daftar → super_admin; dihapus dari daftar → turun ke user).
# Akun lain tidak bisa diangkat menjadi super_admin lewat UI/API/CLI (hanya admin). Kosong = tanpa super_admin
# (halaman /dev terkunci, peringatan di log start).
# contoh produksi: SUPER_ADMIN_EMAILS=ana@example.com,budi@example.com
SUPER_ADMIN_EMAILS=

# Isi 1 hanya untuk test otomatis (e2e): mengaktifkan login tanpa Google POST /api/test/login. Selalu diabaikan bila
# NODE_ENV=production (endpoint 404). Jangan aktifkan di server yang bisa diakses publik; biarkan kosong.
ZOOMIN_TEST_AUTH=

# ── 5. Opsional: TLS lokal ──

# HTTPS langsung dari app (mis. akses LAN/Tailscale tanpa reverse proxy): path sertifikat PEM.
# Set TLS_CERT_PATH dan TLS_KEY_PATH bersamaan atau kosongkan keduanya; kosong = HTTP. Di belakang proxy/tunnel
# biarkan kosong (TLS ditangani proxy). Sertifikat dari `tailscale cert <host>` atau mkcert.
# contoh: TLS_CERT_PATH=./certs/host.crt
TLS_CERT_PATH=
# Kunci privat PEM pasangan TLS_CERT_PATH.
# contoh: TLS_KEY_PATH=./certs/host.key
TLS_KEY_PATH=

# ── 6. Opsional: lokasi SPA produksi ──

# Direktori SPA hasil `bun run build` yang disajikan saat NODE_ENV=production. Opsional, default dist/web (relatif ke
# direktori kerja); binary memakai SPA yang tertanam. Dipakai e2e agar build-nya tidak menimpa dist/web server lain.
WEB_DIST_DIR=

# ── Langkah cepat ──
# 1. zoomin env > .env
# 2. Produksi: NODE_ENV=production, isi LIVEKIT_API_KEY/SECRET, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID/SECRET, SUPER_ADMIN_EMAILS, URL publik
#    (daftarkan origin + redirect URI di Google Cloud Console, lihat bagian 4)
# 3. zoomin check          (validasi; exit 1 bila ada yang salah, secret tidak dicetak)
# 4. zoomin                (jalankan server, buka PUBLIC_APP_URL)
