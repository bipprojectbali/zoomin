# Salin ke .env lalu isi. Di NODE_ENV=production, LIVEKIT_API_KEY/SECRET, SESSION_SECRET (>=32 char),
# dan ADMIN_PASSWORD wajib diset; server gagal start bila kosong.
NODE_ENV=development
PORT=3000
DB_PATH=./data/zoomin.sqlite
# URL LiveKit untuk server-ke-server (Twirp).
LIVEKIT_URL=ws://127.0.0.1:7880
# URL LiveKit untuk browser (wss://lk.<domain> di produksi). Default = LIVEKIT_URL.
PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Kunci HMAC cookie sesi, minimal 32 karakter (mis. `openssl rand -base64 48`).
SESSION_SECRET=
ADMIN_PASSWORD=
# Base URL app untuk link undangan.
PUBLIC_APP_URL=http://localhost:3000
